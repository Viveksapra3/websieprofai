# =============================================================================
# ProfAICoach Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your actual values
# This file contains all environment variables used in the project

# =============================================================================
# DATABASE CONFIGURATION (REQUIRED)
# =============================================================================
# PostgreSQL database connection string
# Used by: server/db.ts, drizzle.config.ts
# Format: postgresql://username:password@host:port/database
DATABASE_URL=postgresql://username:password@localhost:5432/profaicoach

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================
# Server port (default: 5000)
# Used by: server/index.ts
PORT=5000

# Node environment (development/production)
# Used by: server/index.ts, server/routes.ts
NODE_ENV=development

# =============================================================================
# SESSION & SECURITY CONFIGURATION (REQUIRED)
# =============================================================================
# Session secret for signing cookies (CHANGE THIS IN PRODUCTION!)
# Used by: server/index.ts
SESSION_SECRET=your-super-secret-session-key-change-this-in-production

# Session cookie name (default: sid)
# Used by: server/index.ts, server/routes.ts
SESSION_NAME=sid

# Cookie security settings
# Used by: server/index.ts, server/routes.ts
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=

# =============================================================================
# CORS CONFIGURATION
# =============================================================================
# Allowed origins for CORS (comma-separated)
# Used by: server/index.ts
# Default: http://localhost:3000,http://127.0.0.1:3000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# =============================================================================
# AUTHENTICATION REDIRECT URLS
# =============================================================================
# Default redirect URL after authentication
# Used by: server/routes.ts
REDIRECT_URL=/

# Teacher-specific redirect URL after login/signup
# Used by: server/routes.ts
TEACHER_REDIRECT_URL=/teacher/upload

# Student-specific redirect URL after login/signup  
# Used by: server/routes.ts
STUDENT_REDIRECT_URL=/courses

# =============================================================================
# CLIENT-SIDE ENVIRONMENT VARIABLES (VITE)
# =============================================================================
# These variables are prefixed with VITE_ and available in the client

# API base URL for external services
# Used by: client/src/pages/teacher-upload.tsx, courses.tsx, course.tsx, course-quiz.tsx
VITE_API_BASE=http://localhost:5000

# Chat/WebSocket API URL
# Used by: client/src/hooks/useChat.tsx
VITE_API_URL=http://localhost:3000

# Avatar/3D visualization service URL
# Used by: client/src/pages/course.tsx
VITE_AVI_URL=http://localhost:3001

# Auth redirect URL (fallback for client-side redirects)
# Used by: client/src/pages/signup.tsx, signin-student.tsx
VITE_AUTH_REDIRECT_URL=/

# =============================================================================
# OPTIONAL EXTERNAL SERVICES
# =============================================================================
# Add any API keys or external service configurations here as needed
# Examples (not currently used but may be needed for future features):

# OpenAI API Key (if AI features are added)
# OPENAI_API_KEY=your-openai-api-key

# Firebase Configuration (if Firebase is used)
# FIREBASE_API_KEY=your-firebase-api-key
# FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
# FIREBASE_PROJECT_ID=your-project-id

# Email Service (if email notifications are added)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password

# File Upload Service (if cloud storage is used)
# AWS_ACCESS_KEY_ID=your-aws-access-key
# AWS_SECRET_ACCESS_KEY=your-aws-secret-key
# AWS_BUCKET_NAME=your-s3-bucket

# =============================================================================
# DEVELOPMENT NOTES
# =============================================================================
# 1. DATABASE_URL is REQUIRED - the app will not start without it
# 2. SESSION_SECRET should be changed in production for security
# 3. VITE_ prefixed variables are available in the client-side code
# 4. The app uses PostgreSQL with Drizzle ORM
# 5. Sessions are stored in PostgreSQL using connect-pg-simple
# 6. CORS is configured to allow cross-origin requests from specified origins
